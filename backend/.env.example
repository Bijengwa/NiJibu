PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nijibu

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Sign-up / login code: console = printed in this terminal (development) | sms = Africa's Talking SMS | whatsapp = WhatsApp first, SMS if it fails
# Production default: sms
OTP_DELIVERY=console
# CORS_ORIGINS=http://192.168.111.163:5173,http://localhost:5173

# Provider "I have arrived" must be within this many km of the customer. 0 = do not check (dev only)
ARRIVE_MAX_KM=0.5

# NIDA check: mock = test mode (no call to NIDA, auto-verifies). manual = an admin verifies. Default: mock in dev, manual in production.
# NIDA_MODE=mock
# Key for encrypting NIDA numbers (falls back to JWT_SECRET in dev). Set a long random value in production.
# NIDA_KEY=change-me

# Payments: the customer pays in the app, NiJibu keeps COMMISSION_PERCENT, the fundi gets the rest.
# REGISTRATION_FEE=1000  (TSh a worker pays before every identity check; no refund)
# PAYMENTS_MODE=mock  (default in development: fake mobile money. A number ending in 0000 fails.)
# COMMISSION_PERCENT=13
# MIN_PRICE=10000            # the lowest price of a job, in TZS
# MAX_ACTIVE_JOBS=3         # how many jobs one worker can hold at the same time
# OSRM_URL=https://router.project-osrm.org   # road routes for the ETA (use your own OSRM server in production)
# CAR_TRAFFIC_FACTOR=1.35   # car time = road time x this (traffic)
# BIKE_TRAFFIC_FACTOR=1.0   # motorbike time = road time x this

# ---------------------------------------------------------------------------------------------------------------
# SMS + WhatsApp to customers and fundis (OTP code, "fundi accepted", "fundi arrived", "work done", payment messages)
# MESSAGING_MODE: off = nothing | console = print in this terminal (development default) | live = send for real (production default)
# MESSAGING_MODE=console
# Africa's Talking SMS. Username "sandbox" uses their test gateway.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=NIJIBU            # optional, must be approved by Africa's Talking
# Meta WhatsApp Cloud API. Create + get approved these templates in WhatsApp Manager (Swahili "sw" and English "en"):
#   nijibu_otp (authentication, 1 variable: the code), nijibu_request_accepted, nijibu_provider_arrived, nijibu_job_completed,
#   nijibu_payment_done (1 variable: amount), nijibu_payment_received (1 variable: amount)
# WhatsApp is used only for users who turned it on in Settings (whatsapp_opt_in); SMS is the fallback.
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_API_VERSION=v21.0

# ---------------------------------------------------------------------------------------------------------------
# Selcom (customer pays with mobile money). Use PAYMENTS_MODE=selcom (production default). Test with SANDBOX keys first.
# PAYMENTS_MODE=selcom
# SELCOM_BASE_URL=               # the sandbox or live gateway address Selcom gave you (no default)
# SELCOM_VENDOR_ID=
# SELCOM_API_KEY=
# SELCOM_API_SECRET=
# SELCOM_DEFAULT_EMAIL=noreply@nijibu.app   # Selcom needs an email for the buyer when the customer has none
# Selcom tells us when a payment changes. Give Selcom this address (it must be reachable from the internet):
#   <your server>/api/webhooks/selcom/<SELCOM_WEBHOOK_TOKEN>
# SELCOM_WEBHOOK_TOKEN=          # long random text, at least 16 characters
# SELCOM_WEBHOOK_URL=            # the same full address as above
# Paying the fundi (the 90%) through Selcom is NOT connected yet: payouts show as failed (NOT_BUILT) and the admin retries or pays by hand.

# ---------------------------------------------------------------------------------------------------------------
# Place search ("Where are you?"): osm (free, default) or google.
# GOOGLE RULE: Google place/address results may only be shown on a Google map. Keep osm until the app maps are Google Maps.
# PLACES_PROVIDER=osm
# GOOGLE_MAPS_SERVER_KEY=        # server key, restricted to this server's IP and to "Places API (New)" + "Geocoding API"

# ---------------------------------------------------------------------------------------------------------------
# NIDA: mock = demo | manual = admin checks the selfie + ID photo (production default) | live = real NIDA (see src/services/nidaLive.js, not connected yet)
# NIDA_MODE=manual
